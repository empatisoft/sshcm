

#no space after hash
   # indented comment
SendEnv LANG LC_*
Host empty-block

Host quoted
    IdentityFile "~/.ssh/my keys/id_rsa"
    IdentityFile ~/.ssh/second
    ProxyCommand "/usr/local/bin/my proxy" --host %h # not a comment inside quotes: "#"
    SetEnv FOO="bar baz"
    UnknownFutureOption some value

    # trailing comment after a blank line


# Türkçe açıklama: üretim sunucusu
Host üretim
    HostName xn--retim-jua.example.com
    ProxyJump  ops@bastion:2222 , second
    ProxyJump none
	
Host a b c
    HostName shared.example.com
# attached to the block above
Host dup
    Port 22
    Port 2222
    User=
