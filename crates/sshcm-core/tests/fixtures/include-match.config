Include config.d/*
Include ~/.ssh/private.config

# Company defaults
Host *.corp.example.com !bastion.corp.example.com
    ProxyJump bastion
    User onur

Host bastion bastion.corp.example.com
    HostName 198.51.100.7
    LocalForward 8080 localhost:80
    LocalForward 5432 db.internal:5432

Match host *.internal exec "test -f ~/.vpn-up"
    ProxyCommand ssh -W %h:%p bastion
    ForwardAgent yes

Match all
    Compression yes

Host build?
    User ci

Host app
    HostName app.internal
    Include app-extra.config

Host *
    AddKeysToAgent yes
