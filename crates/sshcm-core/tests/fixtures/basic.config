# ~/.ssh/config
# Managed by hand and by sshcm.

# Jump host for the production network
Host bastion
    HostName bastion.example.com
    User ops
    IdentityFile ~/.ssh/id_ed25519

Host db-prod
    HostName 10.0.2.15
    User postgres
    ProxyJump bastion

Host dev
    HostName dev.example.com
    User deploy
    Port 2222

# sshcm:desc Production web server
# sshcm:tags prod, web
Host web-prod
    HostName 10.0.2.10
    User deploy
    IdentityFile ~/.ssh/id_ed25519
    ProxyJump bastion
    ServerAliveInterval 60

Host staging
    HostName 203.0.113.24
    User deploy
    Port 2222
    ProxyCommand nc -X 5 -x 10.0.0.1:1080 %h %p

Host *
    AddKeysToAgent yes
    ServerAliveInterval 30
